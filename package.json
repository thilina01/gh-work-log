{
  "name": "gh-work-log",
  "version": "1.0.0",
  "description": "GitHub cross-repository commit aggregator built on top of gh auth and gh api.",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "bin": {
    "gh-work-log": "./dist/cli.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "visualize": "node dist/visualize.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/node": "^22.15.21",
    "eslint": "^9.25.1",
    "globals": "^16.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^3.2.4"
  }
}
